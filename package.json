{
  "name": "busan-unique-venue-map",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm maplibre:worker && next dev",
    "build": "pnpm maplibre:worker && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "maplibre:worker": "tsx scripts/copy-maplibre-worker.ts",
    "data:build": "tsx scripts/build-venues.ts",
    "data:geocode": "tsx scripts/geocode.ts",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.5.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "csv-parse": "^5.6.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "iconv-lite": "^0.6.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
