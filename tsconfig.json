{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "//exclude": "scripts/ 는 빌드타임 전용이고 csv-parse·iconv-lite(devDependencies)에 의존한다. `npm ci --omit=dev` 로 도는 프로덕션 빌드에서 next build 가 TS2307 로 깨지지 않도록 제외하고, tsconfig.scripts.json 으로 따로 검사한다.",
  "exclude": ["node_modules", "scripts"]
}
